+// Unity-player patch: keep constant buffer structs at their D3D11 (HLSL) byte offsets.
+// Padding fills gaps left by stripped/unused members, and packed vectors reproduce HLSL's
+// 4-byte packing, so the Metal layout matches the engine's D3D-style constant buffer data.
+static uint32_t HLSLVarSize(const ShaderVarType &v)
+{
+    uint32_t n = v.Elements > 1 ? v.Elements : 1;
+    if (v.Class == SVC_STRUCT)
+    {
+        uint32_t end = 0;
+        for (size_t i = 0; i < v.Members.size(); i++)
+            end = std::max(end, v.Members[i].Offset + HLSLVarSize(v.Members[i]));
+        uint32_t stride = (end + 15) & ~15u;
+        return stride * n;
+    }
+    uint32_t regs = 1, last;
+    if (v.Class == SVC_MATRIX_COLUMNS) { regs = v.Columns; last = (v.Columns - 1) * 16 + v.Rows * 4; }
+    else if (v.Class == SVC_MATRIX_ROWS) { regs = v.Rows; last = (v.Rows - 1) * 16 + v.Columns * 4; }
+    else last = v.Columns * 4;
+    return (n - 1) * regs * 16 + last;
+}
+
+void ToMetal::EmitCBPadding(const std::string &name, uint32_t &cursor, uint32_t target)
+{
+    while (cursor < target)
+    {
+        std::ostringstream oss;
+        std::string padName = "hlslcc_pad" + std::to_string(m_PadCounter++);
+        if ((cursor % 16) == 0 && target - cursor >= 16)
+        {
+            uint32_t count = (target - cursor) / 16;
+            oss << "float4 " << padName << "[" << count << "]";
+            cursor += count * 16;
+        }
+        else
+        {
+            oss << "float " << padName;
+            cursor += 4;
+        }
+        m_StructDefinitions[name].m_Members.push_back(std::make_pair(padName, oss.str()));
+    }
+}
